{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@limiarmap/shared-contracts": [
        "packages/shared-contracts/src/index.ts"
      ],
      "@limiarmap/tactical-engine": [
        "packages/tactical-engine/src/index.ts"
      ]
    }
  }
}
