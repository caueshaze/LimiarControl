{
  "name": "limiar",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:control": "npm run dev -w apps/control-web",
    "dev:map": "concurrently -n map-server,map-web \"npm run dev -w apps/map-server\" \"npm run dev -w apps/map-web\"",
    "dev:map:server": "npm run dev -w apps/map-server",
    "dev:map:web": "npm run dev -w apps/map-web",
    "build:control": "npm run build -w apps/control-web",
    "build:map": "npm run build -w apps/map-server && npm run build -w apps/map-web",
    "test": "vitest run --exclude 'apps/map-web/tests/**'",
    "test:control": "npm run test -w apps/control-web",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
